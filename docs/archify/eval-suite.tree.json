  "cards": [
    {
      "title": "Outcome",
      "dot": "slate",
      "items": [
        "Is the answer faithful to its evidence?",
        "MiniCheck (headline), AlignScore, SummaC and FactCC score faithfulness.",
        "ROUGE-L and BERTScore measure summary quality."
      ]
    },
    {
      "title": "Grounding & citation",
      "dot": "slate",
      "items": [
        "Do the cited sources support the claims?",
        "On ASQA, ALCE citation recall and precision, plus exact-match answer recall."
      ]
    },
    {
      "title": "Reliability",
      "dot": "slate",
      "items": [
        "How consistently does the agent succeed?",
        "pass@1, pass@k, pass^k, seed-to-seed standard deviation and run-completion rate."
      ]
    },
    {
      "title": "Trajectory",
      "dot": "slate",
      "items": [
        "How did the agent produce the answer?",
        "Per-call traces, LLM calls and rounds per task, self-termination, completion-cap and blank-output rates."
      ]
    },
    {
      "title": "Efficiency",
      "dot": "slate",
      "items": [
        "What did the answer cost?",
        "Tokens and seconds per task, plus GPU-hours spent training."
      ]
    },
    {
      "title": "Comparative",
      "dot": "slate",
      "items": [
        "Did the added agent steps pay off?",
        "Paired gain over baseline with a 95% CI, token multiplier, gain per 1k extra tokens, Pareto frontier and break-even point."
      ]
    },
    {
      "title": "Ablation",
      "dot": "slate",
      "items": [
        "Which component accounts for the gain?",
        "Compare T2 with T2-noTool to isolate the contribution of the critic’s tool."
      ]
    },
    {
      "title": "Integrity",
      "dot": "slate",
      "items": [
        "Can we trust the evaluation?",
        "Validate judges against human labels, check judge agreement and worked-example leaks, and test for reward exploitation on held-out data (in progress)."
      ]
    }
  ]
